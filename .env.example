# DataVerse Environment Configuration Example
# Copy this file to .dev.vars for local Worker development or set secrets via `wrangler secret put <KEY>`

# Secret key used for signing and verifying JWT tokens (min 32 characters recommended)
JWT_SECRET=your_secure_jwt_secret_key_at_least_32_chars_long

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
