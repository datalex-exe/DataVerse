# Local Cloudflare Worker secrets (used by Wrangler during local dev)
# Run `wrangler secret put JWT_SECRET` for production deployment

JWT_SECRET=your_secure_jwt_secret_key_at_least_32_chars_long
# 256-bit encryption key (32 bytes hex or base64) for AES-256-GCM 2FA secret encryption
TWO_FACTOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
