# Dependencies
node_modules/
**/node_modules/

# Build outputs
frontend/dist/
api/dist/
*.timestamp-*.mjs

# Wrangler local dev state
.wrangler/
**/.wrangler/

# TypeScript compiled output
*.js.map
api/src/**/*.js
!api/src/**/*.test.js

# Environment secrets — never commit these
.env
.env.local
.env.*.local
.dev.vars

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/
